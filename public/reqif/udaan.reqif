        </SPEC-OBJECT>

        <SPEC-OBJECT IDENTIFIER="REQ_002" LAST-CHANGE="2023-10-27T10:00:00+00:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="UDAAN-REQ-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
