              <THE-VALUE><div xmlns="http://www.w3.org/1999/xhtml">The system shall achieve a drop accuracy within a 10 ft by 10 ft target zone during the dive maneuver.</div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Legacy Report "><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
