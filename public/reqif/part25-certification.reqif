      <ns0:SPEC-OBJECTS>
        
        <ns0:SPEC-OBJECT IDENTIFIER="SUBPART_A" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Subpart A - General (25.1 - 25.5)"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Title</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Subpart</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        <ns0:SPEC-OBJECT IDENTIFIER="REQ_A_001" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="CERT-GEN-001"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="25.1"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_CFR</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-XHTML><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-XHTML-REF>ATTR_Text</ns0:ATTRIBUTE-DEFINITION-XHTML-REF></ns0:DEFINITION>
              <ns0:THE-VALUE><html:div><html:strong>Applicability:</html:strong> This part prescribes airworthiness standards for the issuance of type certificates, and changes to those certificates, for transport category airplanes. Applies to: (1) Jets with 10+ seats or MTOW &gt; 12,500 lbs; (2) Propeller aircraft with 19+ seats or MTOW &gt; 19,000 lbs.</html:div></ns0:THE-VALUE>
            </ns0:ATTRIBUTE-VALUE-XHTML>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="14 CFR Part 25"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Regulatory"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Criticality</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_VerificationMethod</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>VM_Analysis</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_ComplianceStatus</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>CS_NotStarted</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Evidence</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ResponsibleParty</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_TargetDate</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Notes</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Requirement</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        <ns0:SPEC-OBJECT IDENTIFIER="REQ_A_002" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="CERT-GEN-002"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="25.3"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_CFR</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-XHTML><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-XHTML-REF>ATTR_Text</ns0:ATTRIBUTE-DEFINITION-XHTML-REF></ns0:DEFINITION>
              <ns0:THE-VALUE><html:div><html:strong>ETOPS Type Design Approval:</html:strong> For ETOPS (Extended Operations) beyond 60 minutes from an adequate airport, the applicant must demonstrate the airplane-engine combination is capable of safe flight considering catastrophic single failures and adverse operating conditions.</html:div></ns0:THE-VALUE>
            </ns0:ATTRIBUTE-VALUE-XHTML>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="14 CFR Part 25"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Safety-Critical"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Criticality</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_VerificationMethod</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>VM_Analysis</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_ComplianceStatus</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>CS_NotStarted</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Evidence</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ResponsibleParty</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_TargetDate</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Notes</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Requirement</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        
        <ns0:SPEC-OBJECT IDENTIFIER="SUBPART_B" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Subpart B - Flight (25.21 - 25.255)"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Title</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Subpart</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        <ns0:SPEC-OBJECT IDENTIFIER="CAT_B_PERF" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Performance Requirements"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Title</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Category</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        <ns0:SPEC-OBJECT IDENTIFIER="REQ_B_001" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="CERT-FLT-001"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="25.21"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_CFR</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-XHTML><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-XHTML-REF>ATTR_Text</ns0:ATTRIBUTE-DEFINITION-XHTML-REF></ns0:DEFINITION>
              <ns0:THE-VALUE><html:div><html:strong>Proof of Compliance:</html:strong> Compliance with the flight requirements must be shown by tests upon an airplane of the type for which certification is requested, or by calculations based on test data from similar airplane configurations.</html:div></ns0:THE-VALUE>
            </ns0:ATTRIBUTE-VALUE-XHTML>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="14 CFR Part 25"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Regulatory"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Criticality</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_VerificationMethod</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>VM_Analysis</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_ComplianceStatus</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>CS_NotStarted</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Evidence</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ResponsibleParty</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_TargetDate</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Notes</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Requirement</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        <ns0:SPEC-OBJECT IDENTIFIER="REQ_B_002" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="CERT-FLT-002"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="25.101-25.125"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_CFR</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-XHTML><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-XHTML-REF>ATTR_Text</ns0:ATTRIBUTE-DEFINITION-XHTML-REF></ns0:DEFINITION>
              <ns0:THE-VALUE><html:div><html:strong>Takeoff Performance:</html:strong> The airplane must meet takeoff performance requirements including: accelerate-stop distance, takeoff distance, takeoff run, and one-engine-inoperative takeoff flight path. Must account for runway slope, wind, and atmospheric conditions.</html:div></ns0:THE-VALUE>
            </ns0:ATTRIBUTE-VALUE-XHTML>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="14 CFR Part 25"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="Safety-Critical"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Criticality</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_VerificationMethod</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>VM_Analysis</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-ENUMERATION>
              <ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF>ATTR_ComplianceStatus</ns0:ATTRIBUTE-DEFINITION-ENUMERATION-REF></ns0:DEFINITION>
              <ns0:VALUES><ns0:ENUM-VALUE-REF>CS_NotStarted</ns0:ENUM-VALUE-REF></ns0:VALUES>
            </ns0:ATTRIBUTE-VALUE-ENUMERATION>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Evidence</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ResponsibleParty</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_TargetDate</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE=""><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Notes</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
          </ns0:VALUES>
          <ns0:TYPE><ns0:SPEC-OBJECT-TYPE-REF>TYPE_Requirement</ns0:SPEC-OBJECT-TYPE-REF></ns0:TYPE>
        </ns0:SPEC-OBJECT>

        <ns0:SPEC-OBJECT IDENTIFIER="REQ_B_003" LAST-CHANGE="2024-12-28T10:00:00+00:00">
          <ns0:VALUES>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="CERT-FLT-003"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-STRING THE-VALUE="25.119-25.125"><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-STRING-REF>ATTR_CFR</ns0:ATTRIBUTE-DEFINITION-STRING-REF></ns0:DEFINITION></ns0:ATTRIBUTE-VALUE-STRING>
            <ns0:ATTRIBUTE-VALUE-XHTML><ns0:DEFINITION><ns0:ATTRIBUTE-DEFINITION-XHTML-REF>ATTR_Text</ns0:ATTRIBUTE-DEFINITION-XHTML-REF></ns0:DEFINITION>
              <ns0:THE-VALUE><html:div><html:strong>Landing Performance:</html:strong> Landing distance must be determined on a level, smooth, dry, hard-surfaced runway. Must demonstrate performance with and without thrust reversers, at maximum landing weight.</html:div></ns0:THE-VALUE>
