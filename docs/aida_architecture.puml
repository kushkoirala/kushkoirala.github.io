@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Monospaced

package "Flight Vehicle" {
  component "Airframe & Control Surfaces" as Airframe
  component "Propulsion & Power System" as Power
  component "Cube Orange\n(ArduPilot)" as Cube
  component "Companion Computer\n(AIDA Autonomy)" as Companion

  package "Sensor Suite" {
    component "Internal IMUs & Baros" as InternalSensors
    component "VectorNav VN-200" as VN200
    component "Digital Pitot-Static" as Pitot
    component "Lightware SF45 Lidar" as Lidar
    component "Luxonis OAK-D Lite Camera" as Camera
    component "Power Monitor" as PowerMon
  }

  package "Comms Bay" {
    component "5 GHz Telemetry Radio" as Radio5G
    component "LTE/5G Modem" as Modem5G
    component "ExpressLRS / Safety RC" as SafetyRC
    component "ADS-B In/Out" as ADSB
  }
}

package "Ground & Digital Twin" {
  component "Mission Control Dashboard" as GroundCtrl
  component "Unreal Engine Visualizer" as UnrealClient
  component "Python Physics Core" as PhysicsCore
  component "PPO Trainer / RL Policies" as PPO
}

InternalSensors --> Cube : raw IMU/gyro/baro
VN200 --> Cube : GNSS/IMU data
Pitot --> Cube : airspeed & altitude
Lidar --> Companion : range/terrain
Camera --> Companion : perception streams
PowerMon --> Companion : power health
Cube --> Airframe : servo commands
Power --> Cube : 5V regulated bus
Power --> Companion : isolated 5V bus
Companion --> Cube : MAVLink\n(setpoints/mode control)
Cube --> Companion : MAVLink\n(state telemetry)

Companion --> Radio5G : IP telemetry/video
Companion --> Modem5G : BVLOS link
SafetyRC --> Cube : manual override
ADSB --> Cube : traffic awareness
ADSB --> GroundCtrl : broadcast ADS-B data
Radio5G --> GroundCtrl : telemetry stream
Radio5G --> UnrealClient : state vectors
Modem5G --> GroundCtrl : redundant backhaul

Companion --> UnrealClient : WebSocket telemetry
Companion <--> PhysicsCore : HIL/SIL interface
PhysicsCore <--> PPO : training data & policies
PPO --> Companion : mission/autonomy logic updates
GroundCtrl --> Companion : high-level commands

UnrealClient --> PhysicsCore : digital twin feedback

note right of Companion
  Runs Ubuntu 22.04 + MAVROS/MAVSDK
  Hosts AIDA autonomy services,
  PPO policy integration, logging.
end note

note left of Cube
  Executes ArduPilot/PX4 firmware
  for deterministic flight control,
  sensor fusion, and failsafes.
end note

@enduml
